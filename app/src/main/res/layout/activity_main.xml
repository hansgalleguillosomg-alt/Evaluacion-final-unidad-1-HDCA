<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Título Principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel de Tareas - Bodega Express"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <!-- BOTONES DE NAVEGACIÓN A LAS OTRAS PANTALLAS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnIrCategorias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Categorías"
            android:layout_marginRight="8dp"
            android:backgroundTint="#2196F3"/>

        <Button
            android:id="@+id/btnIrProductos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Productos"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>

    <!-- Spinner requerido por pauta (Filtro) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filtrar por categoría:"
        android:textSize="12sp"
        android:textColor="#757575"/>

    <Spinner
        android:id="@+id/spinnerCategorias"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0"/>

    <!-- CardView con ProgressBar y RatingBar requeridos por pauta -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progreso de Inventario Diario"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- ProgressBar requerida por pauta -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:progress="65"
                android:layout_marginBottom="12dp"/>

            <!-- RatingBar requerida por pauta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Califique la urgencia del turno:"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="4dp"/>

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1.0"
                android:rating="4.0"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:transformPivotX="0dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- RecyclerView requerido por pauta (Listado de tareas) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tareas Asignadas:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTareas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>